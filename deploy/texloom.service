# systemd unit for the TeXLoom relay server (deploy/install.sh writes the same unit).
# Install: sudo cp deploy/texloom.service /etc/systemd/system/ && sudo systemctl enable --now texloom
[Unit]
Description=TeXLoom relay server
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=texloom
WorkingDirectory=/var/www/texloom
# settings: /etc/texloom/texloom.toml (see INSTALL.md); TEXLOOM_<NAME> in /etc/texloom/env overrides it
EnvironmentFile=-/etc/texloom/env
# buffers over 1 MB (catch-ups, uploads) go back to the system when freed, rather than staying
# in the heap, where MemoryMax would keep counting them
Environment=MALLOC_MMAP_THRESHOLD_=1048576
ExecStart=/var/www/texloom/.venv/bin/texloom-server --config /etc/texloom/texloom.toml --host 127.0.0.1 --port 8787
Restart=on-failure
UMask=0077
MemoryMax=1G
TasksMax=128
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/texloom

[Install]
WantedBy=multi-user.target
