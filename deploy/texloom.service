# systemd unit for the TeXLoom relay server (deploy/install.sh writes the same unit).
# Install: sudo cp deploy/texloom.service /etc/systemd/system/ && sudo systemctl enable --now texloom
[Unit]
Description=TeXLoom relay server
After=network-online.target
Wants=network-online.target

[Service]
User=texloom
WorkingDirectory=/var/www/texloom
ExecStart=/var/www/texloom/.venv/bin/texloom-server --host 127.0.0.1 --port 8787 --db /var/lib/texloom/texloom.db --static /var/www/texloom/web/dist --tex-assets /var/www/texloom/tex-assets --codes-file /etc/texloom/codes.txt --admin-token-file /etc/texloom/admin-token --min-free 2G --project-max-bytes 200M
Restart=on-failure
UMask=0077
MemoryMax=768M
TasksMax=128
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/texloom

[Install]
WantedBy=multi-user.target
